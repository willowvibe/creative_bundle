# drama-studio reads these from the environment, then from this repo's .env.
# In the original setup .env was a symlink to ../video-editor/.env:
#   ln -s ../video-editor/.env .env
# Copy this file to .env only if you keep drama keys separately.

POYO_API_KEY=
SARVAM_API=

# Family review board (apps/drama-review): Worker URL and owner key.
DRAMA_REVIEW_URL=
DRAMA_REVIEW_KEY=

# Optional: path to a runpod-comfyui checkout used by the upscale scripts.
# RPC_REPO=../runpod-comfyui
