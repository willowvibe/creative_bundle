# social-engine does NOT read .env.
# OAuth client secrets, tokens and Chrome profiles live under
# ~/.config/social-engine/ (see README.md and docs/usage.md).
#
# These optional environment overrides are the only variables the code reads.
# SOCIAL_ENGINE_HOME=~/.config/social-engine
# SOCIAL_ENGINE_ROOTS=/path/to/video-projects/videos
# SOCIAL_ENGINE_DRIVER=/path/to/social-engine/browser/driver.mjs
# SOCIAL_ENGINE_VISIBLE=1            # use the owner's desktop for the browser lane
# SOCIAL_ENGINE_XVFB_DISPLAY=:99     # X display used when running headless
