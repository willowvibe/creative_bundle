{
  "mcpServers": {
    "comfyui": {
      "command": "uv",
      "args": ["run", "python", "scripts/comfyui_mcp_server.py"],
      "env": {
        "COMFYUI_URL": "http://localhost:18188"
      }
    },
    "openrouter": {
      "type": "http",
      "url": "https://mcp.openrouter.ai/mcp"
    },
    "video-editor": {
      "command": "uv",
      "args": ["run", "video-editor-mcp"]
    }
  }
}
