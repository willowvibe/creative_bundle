# Copy this file to .env and fill in only the providers your workflow uses.
# config.yaml routes the default LLM tasks through OpenRouter, so that is the
# one key needed to run anything end-to-end. Unset optional providers are
# simply unavailable; nothing else breaks.

# --- Required for the default routing (config.yaml) ---
OPENROUTER_API_KEY=

# --- Optional providers ---
# Free mode instead of OpenRouter (config.free.yaml routes to ollama_cloud_pro):
# OLLAMA_CLOUD_API_KEY=
# Legacy fallback read by OllamaClient / used by config.example.yaml:
# OLLAMA_API_KEY=
# TypeSafe/Jev classifier for the `classify` task in config.yaml:
# TYPESAFE_API_KEY=

# Speech / music:
# ELEVENLABS_API_KEY=
# SARVAM_API=                 # Sarvam Bulbul TTS (Indian languages)
# POYO_API_KEY=               # PoYo music and media

# Image / video generation:
# FAL_KEY=
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=

# Local ACE-Step music service (the `ace_step` provider in config.yaml):
# ACE_STEP_API_KEY=

# Stock footage and SFX:
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# FREESOUND_API_KEY=
# OPENVERSE_API_KEY=          # optional; anonymous requests work without it

# --- Optional paths ---
# Keep run data (projects, outputs, queue DB, cache) outside the checkout:
# VIDEO_EDITOR_DATA_DIR=/path/to/video-editor-data
# Finer-grained overrides (they win over VIDEO_EDITOR_DATA_DIR):
# VE_WORK_ROOT=/path/to/projects
# VE_OUTPUT_ROOT=/path/to/outputs
# VE_CACHE_DIR=/path/to/cache
