# Generative asset provider API keys for the video editor engine.
# Copy this file to .env and fill in your real keys.

# LLM provider (matches default_provider: openrouter in config.yaml; config.free.yaml uses ollama_cloud_pro)
OLLAMA_CLOUD_API_KEY=sk_your_ollama_key_here

# Optional OpenRouter provider (used when config.yaml routes tasks to openrouter)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# TypeSafe/Jev classifier (batched per-item judgments; route via the "classify"
# task in config.yaml). Not a chat model — https://docs.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_key_here

# Generative asset providers
ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here
POYO_API_KEY=sk_your_poyo_key_here
FAL_KEY=your_fal_key_here
OPENAI_API_KEY=sk-your_openai_key_here
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# Free stock providers (B-roll). Pexels/Pixabay need keys; Coverr/Mixkit don't.
PEXELS_API_KEY=your_pexels_key_here
PIXABAY_API_KEY=your_pixabay_key_here

# Free SFX providers. Freesound needs an APIv2 token (the "API key" on the
# applications page); the client id/secret are only for OAuth original-quality
# downloads, which this engine does not use — it downloads previews.
FREESOUND_API_KEY=your_freesound_api_key_here
# Optional: raises the Openverse rate limit; anonymous requests work.
OPENVERSE_API_KEY=

# Sarvam Bulbul TTS (https://docs.sarvam.ai/)
SARVAM_API=

# Optional: route Claude Code through the local pxpipe proxy to reduce token
# consumption by rendering bulky text context as images. Install/run proxy via:
#   pnpm pxpipe
#   ANTHROPIC_BASE_URL=http://127.0.0.1:47821 claude
# ANTHROPIC_BASE_URL=http://127.0.0.1:47821

# Keep run data (projects, outputs, queue DB, layerize cache) out of the
# checkout (A13). Uncomment and point at a large disk:
# VIDEO_EDITOR_DATA_DIR=/mnt/data/video-editor
# Optional finer-grained overrides (they win over the data dir):
# VE_WORK_ROOT=/mnt/fast/projects
# VE_OUTPUT_ROOT=/mnt/fast/outputs
# VE_CACHE_DIR=/mnt/fast/cache
